# ─────────────────────────────────────────────────────────────────────────────
# n8n-apify-hubspot-competitor-pricing-page-diff-tracker — environment template
# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.
# Safe defaults: with these values the workflow uses synthetic fixtures,
# writes nothing to HubSpot and sends nothing to Slack.
# ─────────────────────────────────────────────────────────────────────────────

# ── Safety flags (leave as-is until staging is verified) ─────────────────────
SANDBOX_MODE=true
DRY_RUN=true
HUBSPOT_LOGGING_ENABLED=false
SEND_SLACK_ALERTS=false
SEND_OPS_ALERTS=false

# ── HubSpot (private app: crm.objects.custom.read + crm.objects.custom.write) ─
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_COMPETITOR_OBJECT_TYPE=p99000001_competitor_pricing
HUBSPOT_BATCH_SIZE=50

# ── Apify ────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=replace-with-apify-api-token
APIFY_ACTOR_ID=mock-user~pricing-page-scraper
APIFY_RUN_TIMEOUT_SECS=240
# Optional extra actor input merged into every run (JSON object, single line)
APIFY_ACTOR_INPUT_JSON={"proxyConfiguration":{"useApifyProxy":true}}

# ── Competitor targets (JSON array, single line; example.com placeholders) ───
COMPETITOR_TARGETS_JSON=[{"competitorKey":"competitor-alpha","competitorName":"CompetitorAlpha Inc","pricingUrl":"https://competitor-alpha.example.com/pricing","hubspotRecordId":"comp_001"},{"competitorKey":"beta-metrics","competitorName":"BetaMetrics Corp","pricingUrl":"https://betametrics.example.com/pricing","hubspotRecordId":"comp_002"}]

# ── Diff thresholds ──────────────────────────────────────────────────────────
PRICE_CHANGE_THRESHOLD_PCT=5
ANNUAL_DISCOUNT_SHIFT_THRESHOLD_PP=5
SUSPECT_TIER_REMOVAL_RATIO=0.5
ALERT_MIN_SEVERITY=high

# ── Alerting webhooks (placeholders) ─────────────────────────────────────────
SLACK_PRICING_ALERT_WEBHOOK_URL=https://hooks.example.com/slack/pricing-alerts
ALERT_WEBHOOK_URL=https://alerts.example.com/ops/competitor-pricing

# ── Optional: pin the run clock (ISO 8601) for backfills / reproducible tests ─
RUN_TIMESTAMP_OVERRIDE=

# ── n8n instance setting: Code nodes and expressions must be able to read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
